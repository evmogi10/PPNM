CXX = g++
CXXFLAGS += -std=c++20 -I. -Wall -Wextra -O3
LDLIBS += -lstdc++ -lm

all: out.txt plot_results.svg

plot_results.svg: plot.gnu hydrogen_wave.txt
	gnuplot $<

hydrogen_wave.txt out.txt: main
	./main > out.txt
	cat out.txt

main: main.o matrix.o
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDLIBS)

matrix.o: matrix.cc matrix.h qr.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

main.o: main.cc roots.h matrix.h qr.h ode.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	$(RM) main *.o *.txt *.svg
